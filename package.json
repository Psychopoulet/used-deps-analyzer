{

  "name": "used-deps-analyzer",
  "version": "0.4.1",
  "description": "Analyse js code to force match between installed & used deps.",

  "type": "commonjs",
  "typings": "./lib/cjs/main.d.cts",
  "main": "./lib/cjs/main.cjs",

  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/main.d.cts",
        "default": "./lib/cjs/main.cjs"
      }
    }
  },

  "scripts": {

    "install-prod": "bun install --production",
    "install-dev": "bun install && bunx husky",

    "lint-bin": "bunx eslint --config .eslintrc-bin.js --ext .js,.cjs,.mjs \"./bin/**/*\"",
    "lint-back": "bunx eslint --config .eslintrc-back.js --ext .ts,.cts,.mts \"./lib/src/**/*\"",
    "lint-tests": "bunx eslint --config .eslintrc-tests.js --ext .js,.cjs,.mjs \"./test/**/*\"",
    "lint": "bun run lint-bin && bun run lint-back && bun run lint-tests",

    "clean-back": "bunx rimraf ./lib/cjs",
    "clean": "bun run clean-back",

    "build-back": "bun run clean-back && bunx tsc --project ./tsconfig.json",
    "build": "bun run build-back",

    "check-node-engine": "bunx check-node-engine",
    "check-requires": "bun ./bin/cmd.js ./package.json ./lib/src --no-dev",
    "check-updates": "bunx check-version-modules --no-fail-at-major --fail-at-minor --fail-at-patch",
    "unit-tests": "bun test --conditions=require --coverage",
    "unit-tests-local": "bun test --conditions=require --coverage --coverage-reporter=text",

    "tests": "bun run lint && bun run check-node-engine && bun run check-requires && bun run check-updates && bun run build && bun run unit-tests"

  },
  "bin": {
    "used-deps-analyzer": "./bin/cmd.js"
  },

  "files": [
    "/bin",
    "/lib/cjs"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24.22.3",
    "bun": ">=1.4.5"
  },

  "dependencies": {},
  "devDependencies": {
    "@types/node": "26.6.11",
    "check-node-engine": "1.2.1",
    "check-version-modules": "2.5.2",
    "eslint-plugin-personnallinter": "git+ssh://git@github.com/Psychopoulet/eslint-plugin-personnallinter",
    "husky": "9.1.7",
    "rimraf": "6.1.4",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "colors": "1.4.0"
  },

  "keywords": [
    "js",
    "jsx",
    "ts",
    "tsx",
    "deps",
    "analyze"
  ],
  "author": "Sébastien VIDAL",
  "license": "ISC",

  "homepage": "https://github.com/Psychopoulet/used-deps-analyzer#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/Psychopoulet/used-deps-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/Psychopoulet/used-deps-analyzer/issues"
  }

}
